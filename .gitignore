# dependencies / build output
node_modules/
web/dist/
web/node_modules/
web/.vite/
dist/
worker/.wrangler/

# browser verification artifacts (screenshots + logs) â€” regenerated on demand
web/test/artifacts/

# generated at build/dev time by web/scripts/sync-data.mjs â€” the canonical
# copies of these registries live at the repo root (data/*.json, sources.json)
web/public/data/
web/public/basemap/

# python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# local secrets â€” never commit keys
.env
.env.*
!.env.example
*.bak-*

# Runtime logs from local dev servers (must never be committed).
# web/dev.log was missed and got staged once — match the whole family, not each
# name, so the next server that writes a log is covered before it is written.
*-dev.log
web/dev.log
web/*.log
worker-dev.log
web/preview.log
.commitmsg
.msg
.commit-msg*
*.tmp
.cmsg
cmsg.tmp
commit-msg.tmp
msg.tmp
