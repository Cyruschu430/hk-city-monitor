{
 "_comment": "Modes, not regions: HKCM covers one city, so the World-Monitor-style switcher varies by QUESTION rather than by geography. A vertical is a config object, never a code path - ui/rail.ts renders every entry here, so adding a mode is a JSON edit. 'question' is mandatory: a mode that cannot answer one does not ship. Every panel and layer id below must exist in panels.json / layers.json (scripts/validate_config.py enforces both directions). A trigger: null mode is reachable from the rail, which is the normal case for a mode a human chooses rather than one the data forces.",
 "windows": [
  "now",
  "today",
  "7d",
  "season",
  "year"
 ],
 "scopes": [
  "hk",
  "district",
  "route"
 ],
 "verticals": [
  {
   "id": "typhoon",
   "name": {
    "tc": "颱風模式",
    "en": "Typhoon Mode"
   },
   "question": {
    "tc": "會唔會掛 8 號？聽日飛唔飛得成？",
    "en": "Will signal 8 be hoisted, and will my flight leave tomorrow?"
   },
   "trigger": {
    "any": [
     {
      "source": "hko_warnsum",
      "field": "TC8",
      "op": "exists"
     },
     {
      "source": "hko_warnsum",
      "field": "TC3",
      "op": "exists"
     }
    ]
   },
   "panels": [
    "ai_brief",
    "warnings_list",
    "tc_track_image",
    "radar_image",
    "rain_nowcast_map",
    "flight_table",
    "special_traffic_list"
   ],
   "layers": [
    "cameras_all",
    "rain_nowcast"
   ],
   "window": "now",
   "location_scope": "hk",
   "order": ["ai_brief", 
    "warnings_list",
    "tc_track_image",
    "rain_nowcast_map",
    "flight_table",
    "radar_image",
    "special_traffic_list"
   ]
  },
  {
   "id": "border",
   "name": {
    "tc": "口岸模式",
    "en": "Border Crossing Mode"
   },
   "question": {
    "tc": "而家過關要等幾耐？",
    "en": "How long is the queue at the control point right now?"
   },
   "trigger": null,
   "panels": [
    "ai_brief",
    "tp_queue_grid",
    "crossboundary_ferry_table",
    "special_traffic_list"
   ],
   "layers": [
    "control_points",
    "cameras_all"
