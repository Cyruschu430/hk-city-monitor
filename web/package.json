{
  "name": "hk-city-monitor-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "HK City Monitor v0.2 front end — Vite + TypeScript (strict), MapLibre + deck.gl, config-driven panels.",
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "predev": "node scripts/sync-data.mjs",
    "prebuild": "node scripts/sync-data.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "check:css": "node scripts/check-tokens.mjs",
    "check:encoding": "node scripts/check-encoding.mjs src scripts ../data ../sources.json",
    "check:basemap": "node scripts/check-basemap.mjs",
    "check:static": "npm run check:css && npm run check:encoding && npm run check:basemap",
    "test": "node src/lib/trigger.test.ts && node src/lib/context.test.ts && node src/lib/honesty.test.ts && node src/lib/render.test.ts && node src/lib/parsers.test.ts && node src/lib/sources.test.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "measure:boot": "node scripts/measure-boot.mjs",
    "check:carpark": "node scripts/verify-carpark.mjs",
    "check:quota": "node scripts/check-quota.mjs",
    "check:layers": "node scripts/check-layers.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "maplibre-gl-wind": "^0.2.1"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@loaders.gl/3d-tiles": "^4.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
